{
  "name": "khosra",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/finalize.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/test-offline.mjs",
    "format": "prettier --write src tests scripts *.ts *.js *.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "dexie": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
